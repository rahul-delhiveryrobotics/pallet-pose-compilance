# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Testing / tooling caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.coverage
htmlcov/

# Large data (datasets are NOT pushed to GitHub; see DATASET.md for sources).
# Only small tracked artefacts (manifests, the dataset summary reports) are kept.
data/**
!data/.gitkeep

# Local real demonstration photos are private/untracked and are not part of the
# submitted training/evaluation corpus.
SOP_CV_Lab_Photos/
SOP_CV_Lab_Photos_JPG/

# Trained model weights: tracked (they are small, <25MB total) so the repo is
# self-contained per the assignment ("trained weights or link"). If they grow,
# switch to a release/link and re-ignore.
# weights/ is intentionally NOT ignored.

# Training run logs / checkpoints (large, regenerable)
runs/**
!runs/.gitkeep

# Generated outputs: keep illustrative assignment examples and failure images,
# ignore ad-hoc live captures.
outputs/**
!outputs/.gitkeep
!outputs/examples/
!outputs/examples/**
!outputs/failure_cases/
!outputs/failure_cases/**

# Stock/pretrained base weights downloaded by ultralytics (not our artefacts)
/yolo*.pt
weights/yolo26n.pt
weights/yolo26n-pose.pt
weights/yolo11n-pose.pt

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
